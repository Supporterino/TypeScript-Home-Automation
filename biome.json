{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/tests/**",
      "docs/examples/**",
      "scripts/**",
      "*.json",
      "!packages/web-ui/src/assets/manifest.ts",
      "!packages/web-ui/src/assets/icon-svg.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/web-ui/src/app/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
