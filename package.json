{
  "name": "ts-home-automation-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript-based home automation framework for Zigbee2MQTT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --conditions=development run scripts/dev.ts",
    "start": "bun --conditions=development run packages/cli/src/index.ts run",
    "test": "bun run --filter '@ts-ha/*' test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write . && bun run scripts/guard-contracts.ts && bun run scripts/guard-deps.ts",
    "typecheck": "bun run --filter '@ts-ha/*' typecheck && tsc -p docs/examples/tsconfig.json --noEmit",
    "build": "bun run --filter '@ts-ha/shared' build && bun run --filter '@ts-ha/core' build && bun run --filter '@ts-ha/web-ui' build && bun run --filter '@ts-ha/cli' build",
    "version": "changeset version",
    "publish": "bun run scripts/resolve-workspace-protocol.ts && changeset publish",
    "docker:build": "docker build -t home-automation .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "home-automation",
    "mqtt",
    "zigbee2mqtt",
    "zigbee",
    "shelly",
    "iot",
    "smart-home",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Supporterino/TypeScript-Home-Automation"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^3.0.3",
    "@ts-ha/core": "workspace:*",
    "@ts-ha/shared": "workspace:*",
    "@types/bun": "^1.3.12",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "pino-pretty": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "allowScripts": {}
}
