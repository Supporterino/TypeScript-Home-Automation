{
  "name": "@ts-ha/web-ui",
  "version": "0.8.0",
  "description": "Web UI service plugin and React application for TypeScript Home Automation",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "OFL.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web-ui": "bun run scripts/generate-icon.ts && bun run scripts/build-web-ui.ts",
    "harness": "bun --conditions=development run scripts/harness.ts",
    "prebuild": "bun run build:web-ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/app/tsconfig.json",
    "pretypecheck": "bun run build:web-ui",
    "test": "bun test --conditions=development",
    "pretest": "bun run build:web-ui",
    "prepublishOnly": "bun run build"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supporterino/TypeScript-Home-Automation.git",
    "directory": "packages/web-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@ts-ha/shared": "workspace:*",
    "clsx": "^2.1.1",
    "hono": "^4.12.14",
    "lucide-react": "^1.56.0",
    "pino": "^10.3.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3"
  }
}
