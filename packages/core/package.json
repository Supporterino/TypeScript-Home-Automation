{
  "name": "@ts-ha/core",
  "version": "0.2.0",
  "description": "Engine, services, device sources, HTTP server, MQTT, state and scheduling for TypeScript Home Automation",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=development",
    "prepublishOnly": "bun run build"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supporterino/TypeScript-Home-Automation.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ts-ha/shared": "workspace:*",
    "chacha": "^2.1.0",
    "cron": "^4.4.0",
    "hap-nodejs": "^0.14.3",
    "hono": "^4.12.14",
    "mqtt": "^5.15.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "pino-pretty": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  }
}
