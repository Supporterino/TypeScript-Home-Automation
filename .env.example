TZ=Europe/Berlin
MQTT_HOST=localhost
MQTT_PORT=1883
ZIGBEE2MQTT_PREFIX=zigbee2mqtt

# NOTE: the default `ts-home-automation` below is the intentionally retained
# on-wire Shelly MQTT RPC source identifier (specs/configuration). It is NOT the
# package name and MUST NOT be rebranded. Two instances that share a broker use
# the literal to disambiguate RPC responses, so changing it is a wire change.
# src identifier used in Shelly MQTT RPC requests (ShellyService's MQTT
# transport). Set a distinct value per app instance if multiple instances
# share one broker, to avoid cross-talk on RPC responses.
MQTT_SHELLY_RPC_SRC=ts-home-automation
LOG_LEVEL=info

# State persistence defaults to true: the store holds room definitions and
# automation enabled flags, which must survive a restart (design.md D6, R14).
STATE_PERSIST=true
STATE_FILE_PATH=./state.json
# Milliseconds between coalesced state saves (write-behind debounce). `0`
# saves on every write. Raise this on SD-card-backed hosts, lower it on fast
# storage. An abrupt kill loses only mutations from the current window.
STATE_FLUSH_MS=1000

AUTOMATIONS_RECURSIVE=false
HTTP_PORT=8080
HTTP_TOKEN=

# Web UI (served on the same port as HTTP_PORT).
# `WEB_UI_ENABLED` and `WEB_UI_PATH` are parsed by the optional `@ts-ha/web-ui`
# package, which `ts-ha run` registers when enabled — they are NOT part of the
# core engine config schema.
WEB_UI_ENABLED=false
WEB_UI_PATH=/status

# Refresh interval, in milliseconds, for HTTP-transport Shelly devices and
# the Nanoleaf device source in the unified device layer (web UI / HomeKit).
SHELLY_POLL_MS=10000
NANOLEAF_POLL_MS=10000

DEVICE_REGISTRY_ENABLED=false
# Defaults to true, alongside STATE_PERSIST: the device list and capability
# schema should be readable immediately on boot, before the bridge
# republishes (design.md D6).
DEVICE_REGISTRY_PERSIST=true
DEVICE_REGISTRY_FILE_PATH=./device-registry.json

# Energy monitoring: the engine samples the aggregate device source on
# ENERGY_SAMPLE_MS and keeps a bounded, rolling in-memory history of the
# home's instantaneous power for ENERGY_HISTORY_MINUTES. `0` disables history
# (current totals remain available). History does not survive a restart.
ENERGY_SAMPLE_MS=60000
ENERGY_HISTORY_MINUTES=1440

# Weather: default location for `GET /api/weather` when a client supplies none.
# Both WEATHER_LATITUDE and WEATHER_LONGITUDE must be set for a default location
# to be configured (ranges -90..90 and -180..180). WEATHER_FORECAST_DAYS is
# clamped to a maximum of 7. Leave the coordinates unset to require clients to
# supply a location.
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=
WEATHER_FORECAST_DAYS=3
